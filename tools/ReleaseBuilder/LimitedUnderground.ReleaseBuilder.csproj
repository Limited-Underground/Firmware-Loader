<Project Sdk="Microsoft.NET.Sdk">
  <!-- L7 step 2: builds a qualification release folder for the owner to review and sign.
       Uses the Loader's own code so the record is byte-identical to what the Loader parses. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>LimitedUnderground.ReleaseBuilder</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="System.IO" />
    <ProjectReference Include="..\..\src\LimitedUnderground.FirmwareLoader\LimitedUnderground.FirmwareLoader.csproj" />
  </ItemGroup>
</Project>
