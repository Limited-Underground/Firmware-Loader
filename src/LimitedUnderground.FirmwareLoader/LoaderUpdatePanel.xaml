<UserControl x:Class="LimitedUnderground.FirmwareLoader.LoaderUpdatePanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 FontFamily="Microsoft Sans Serif" FontSize="13" MinWidth="400">
 <Border Background="#FFFFFF" BorderBrush="#808080" BorderThickness="1" Padding="16" Margin="0,16,0,0">
  <StackPanel>
   <TextBlock Text="{Binding SessionLabel}" Foreground="#800000" FontWeight="Bold" TextWrapping="Wrap" />
   <TextBlock Text="Install firmware" FontSize="19" FontWeight="Bold" Margin="0,10,0,8" />
   <TextBlock Text="Choose the board" Margin="0,0,0,4" />
   <ComboBox x:Name="DeviceList" ItemsSource="{Binding Choices}" DisplayMemberPath="DisplayName"
    SelectedItem="{Binding SelectedChoice, Mode=TwoWay}" IsEnabled="{Binding CanChoose}" MinHeight="32"
    AutomationProperties.Name="Choose the board" />
   <TextBlock x:Name="SummaryText" Text="{Binding Summary}" Margin="0,10,0,0" TextWrapping="Wrap" />
   <Border Background="#FFFFE1" BorderBrush="#808000" BorderThickness="1" Padding="12" Margin="0,12,0,8">
    <StackPanel>
     <TextBlock x:Name="StatusHeading" Text="{Binding Heading}" FontWeight="Bold" FontSize="16" TextWrapping="Wrap" />
     <TextBlock x:Name="StatusDetail" Text="{Binding Detail}" TextWrapping="Wrap" Margin="0,6,0,0" />
    </StackPanel>
   </Border>
   <ItemsControl x:Name="StepList" ItemsSource="{Binding Steps}" Margin="0,0,0,6"
    AutomationProperties.Name="Install steps">
    <ItemsControl.ItemTemplate>
     <DataTemplate>
      <StackPanel Orientation="Horizontal" Margin="0,1">
       <TextBlock Text="{Binding Mark}" Width="20" FontWeight="Bold" />
       <TextBlock Text="{Binding Label}" Width="190" />
       <TextBlock Text="{Binding StatusText}" Foreground="#404040" />
      </StackPanel>
     </DataTemplate>
    </ItemsControl.ItemTemplate>
   </ItemsControl>
   <ProgressBar Height="8" Minimum="0" Maximum="1" Value="{Binding ProgressValue, Mode=OneWay}"
    AutomationProperties.Name="Steps completed; completion requires verification" />
   <TextBlock x:Name="NextStepText" Text="{Binding NextStep}" FontWeight="Bold" TextWrapping="Wrap" Margin="0,8,0,0" />
   <CheckBox x:Name="ConfirmationBox" IsChecked="{Binding Confirmed, Mode=TwoWay}" IsEnabled="{Binding CanConfirm}" Margin="0,12,0,10">
    <TextBlock Text="{Binding ConfirmationLabel}" TextWrapping="Wrap" />
   </CheckBox>
   <WrapPanel>
    <Button x:Name="StartButton" Content="{Binding ActionLabel}" IsEnabled="{Binding CanStart}" Click="Start_Click" Padding="12,8" Margin="0,0,8,8" />
    <Button x:Name="CancelButton" Content="Cancel attempt" IsEnabled="{Binding CanCancel}" Click="Cancel_Click" Padding="12,8" Margin="0,0,8,8" />
    <Button x:Name="RecoveryButton" Content="Review recovery" IsEnabled="{Binding CanReviewRecovery}" Click="Recovery_Click" Padding="12,8" Margin="0,0,8,8" />
    <Button x:Name="SupportButton" Content="Save a support file" IsEnabled="{Binding CanSaveSupportFile}" Click="Support_Click" Padding="12,8" Margin="0,0,0,8" />
   </WrapPanel>
   <Expander x:Name="DetailsExpander" Header="Details" Margin="0,4,0,0">
    <StackPanel Margin="0,4,0,0">
     <TextBlock Text="{Binding Target}" TextWrapping="Wrap" />
     <TextBlock Text="{Binding Selection}" Margin="0,4,0,0" TextWrapping="Wrap" />
     <TextBlock Text="{Binding Firmware}" Margin="0,4,0,0" TextWrapping="Wrap" />
     <TextBlock Text="{Binding ImageDigest}" Margin="0,4,0,0" TextWrapping="Wrap" FontSize="11" />
    </StackPanel>
   </Expander>
  </StackPanel>
 </Border>
</UserControl>
